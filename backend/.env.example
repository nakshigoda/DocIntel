# Groq API Key (Required for LLM answer generation, summarization, extraction, and comparison)
# Get a free key at: https://console.groq.com/
GROQ_API_KEY=gsk_your_groq_api_key_here

# LLM model to use via Groq API
GROQ_MODEL=qwen/qwen3.8-27b

# MongoDB Connection URI (Defaults to localhost if omitted)
MONGO_URI=mongodb://localhost:27017

# Optional: Google Gemini API key (Supported for future extension)
# GEMINI_API_KEY=your_gemini_api_key_here
